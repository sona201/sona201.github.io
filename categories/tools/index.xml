&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://hugo.aiaide.com/post/%E8%87%AA%E5%AE%9A%E4%B9%89hugo%E4%B8%BB%E9%A2%98-%E4%BB%8E%E5%86%85%E5%AE%B9%E9%A1%B5%E5%BC%80%E5%A7%8B/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
